{
  "schemaVersion": 2,
  "manifest": {
    "fixturesVersion": "2026-08-16.p0",
    "offlineHeadroomVersion": "not-invoked-offline",
    "offlineRtkVersion": "not-invoked-offline",
    "defaultProfile": "offline-static"
  },
  "minimumFixtures": 12,
  "minimumCategories": 6,
  "requiredCategories": [
    "shell_output",
    "repo_context_pack",
    "document_conversion",
    "tool_heavy_transcript",
    "streaming_bypass",
    "cache_bust",
    "headroom_refusal"
  ],
  "requiredFields": [
    "category",
    "name",
    "original",
    "optimized",
    "relevantFacts",
    "optimizedFacts",
    "wrongOmissions"
  ],
  "qualityGates": {
    "minimumRelevantFactRetentionPct": 95,
    "maximumWrongOmissionRatePct": 0
  },
  "regressionThresholds": {
    "maximumAggregateSavedPctDrop": 2,
    "maximumAggregateLatencyIncreaseMs": 2,
    "maximumPerFixtureSavedPctDrop": 5,
    "maximumPerFixtureLatencyIncreaseMs": 5,
    "maximumFactRetentionDropPct": 0,
    "maximumWrongOmissionIncreasePct": 0,
    "minimumStaticSuccessPassRatePct": 100
  }
}

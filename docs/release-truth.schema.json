{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["productName", "repository", "appVersion", "publicRelease", "evidence", "claimPolicy"],
  "properties": {
    "productName": { "const": "AI Switchboard" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "appVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publicRelease": {
      "type": "object",
      "required": ["tag", "status", "asset", "source"],
      "properties": {
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["documented", "verified", "unverified"] },
        "asset": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "additionalProperties": { "enum": ["verified", "documented", "unverified", "blocked"] }
    },
    "claimPolicy": {
      "type": "object",
      "required": ["measuredNumbersRequireProvenance", "unverifiedEvidenceMustNotBePresentedAsLive", "releaseStatusAndAppVersionMustBeShownSeparately"],
      "additionalProperties": { "type": "boolean" }
    }
  },
  "additionalProperties": false
}
